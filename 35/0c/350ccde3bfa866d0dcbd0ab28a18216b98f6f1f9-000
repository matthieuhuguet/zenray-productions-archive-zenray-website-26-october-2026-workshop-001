const html=`<!doctype html><html lang="fr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Works, trois propositions typographiques</title><style>${fontCss}
:root{--font-title:'GT Ultra';--font-body:'Literata';--font-ui:'GT Standard L';--font-num:'GT Ultra';--paper:#f6f5f2;--ink:#242422}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px var(--font-ui)}header{padding:28px 30px 20px;border-bottom:1px solid #d8d5ce}h1{font:400 34px var(--font-title);margin:0 0 10px}p{font:400 15px/1.6 var(--font-body);margin:0 0 12px}.toolbar{display:flex;gap:12px;flex-wrap:wrap;align-items:center}button,select{font:400 14px var(--font-ui);border:1px solid #cbc8c0;background:white;border-radius:7px;padding:8px 12px;color:inherit;cursor:pointer}button[aria-pressed=true]{background:#262624;color:white}main{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;padding:22px}article{min-width:0;background:white;border:1px solid #d9d6d0;border-radius:10px;overflow:hidden}article h2{font:400 23px var(--font-title);margin:0 0 12px}.panel{padding:18px;display:grid;gap:12px}.row{display:flex;gap:10px;flex-wrap:wrap}label{display:grid;gap:5px;flex:1;min-width:120px}select{width:100%}.viewport{height:770px;overflow:auto;background:white}iframe{width:1440px;height:6000px;border:0;display:block;transform-origin:top left}.framebox{overflow:hidden}main.focus{display:block;max-width:1600px;margin:auto}main.focus article:not(.selected){display:none}.status{font:12px var(--font-ui);min-height:16px;color:#595950}textarea{width:100%;height:85px;font:12px monospace}.hidden{display:none}@media(max-width:850px){main{grid-template-columns:1fr;padding:12px}header{padding:20px}h1{font-size:28px}}
</style><header><h1>Works, trois propositions typographiques</h1><p>Même page, mêmes textes et mêmes images. Seules les polices changent. Corps en Literata, nombres en GT Ultra.</p><div class="toolbar"><button id="compare" aria-pressed="true">Comparer les trois</button><button id="desktop" aria-pressed="true">Bureau</button><button id="mobile" aria-pressed="false">Mobile</button><button id="reset">Réinitialiser</button><button id="copy">Copier les valeurs pour le prompt</button></div><p class="status" id="message" aria-live="polite">Les menus de chaque proposition permettent aussi de tester GT America.</p><textarea id="output" class="hidden" aria-label="Valeurs à copier"></textarea></header><main>${settings.presets.map((p,i)=>`<article data-index="${i}"><div class="panel"><h2>${p.id}. ${p.title}</h2><div class="row"><label>Titres<select data-key="title">${options}</select></label><label>Nom ZenRay<select data-key="brand">${options}</select></label></div><div class="row"><label>Interface<select data-key="ui"><option>GT Standard L</option><option>GT America</option></select></label><label>Taille des titres <input data-key="scale" type="range" min="85" max="115" value="100" aria-label="Taille des titres"></label></div><button data-open>Voir en pleine largeur</button><div class="status" data-loaded></div></div><div class="viewport"><div class="framebox"><iframe title="Proposition ${p.id}, Works" sandbox="allow-same-origin"></iframe></div></div></article>`).join('')}</main><script>
const SNAPSHOTS=${JSON.stringify(snapshots).replace(/</g,'\\u003c')};const FONT_CSS=${JSON.stringify(fontCss)};const DEFAULTS=${JSON.stringify(settings)};let mode='desktop';const state=DEFAULTS.presets.map(p=>({...p,brand:DEFAULTS.brand,scale:100}));
function documentFor(width){return '<!doctype html><html><head><meta charset="utf-8"><style>'+FONT_CSS+'html,body{margin:0;background:#fff}*{font-family:var(--font-ui)!important;font-weight:400!important;font-synthesis:none} [data-role=body],[data-role=body] *{font-family:var(--font-body)!important} [data-role=title],[data-role=title] *{font-family:var(--font-title)!important} [data-brand],[data-brand] *{font-family:var(--font-brand)!important} .num{font-family:var(--font-num)!important} [data-hover-card]:hover [data-hover-info]{opacity:1!important;transform:none!important}body{overflow-x:hidden}</style></head><body>'+SNAPSHOTS[width].html+'</body></html>'}
function apply(i){const card=document.querySelectorAll('article')[i],doc=card.querySelector('iframe').contentDocument;if(!doc?.body)return;const s=state[i],r=doc.documentElement;Object.entries({'--font-title':s.title,'--font-brand':s.brand,'--font-body':DEFAULTS.body,'--font-ui':s.ui,'--font-num':DEFAULTS.number}).forEach(([k,v])=>r.style.setProperty(k,'"'+v+'"'));doc.querySelectorAll('[data-role=title]').forEach(e=>{if(!e.dataset.baseSize)e.dataset.baseSize=parseFloat(e.style.fontSize)||20;e.style.fontSize=(e.dataset.baseSize*s.scale/100)+'px'});doc.fonts.ready.then(()=>{card.querySelector('[data-loaded]').textContent=[s.title,s.ui,DEFAULTS.body,DEFAULTS.number].every(f=>doc.fonts.check('16px "'+f+'"'))?'Polices chargées':'Chargement des polices…'});}
function layout(){document.querySelectorAll('article').forEach(card=>{const frame=card.querySelector('iframe'),width=mode==='mobile'?390:1440;const scale=Math.min(1,card.clientWidth/width);frame.style.width=width+'px';frame.style.transform='scale('+scale+')';const h=frame.contentDocument?.body?.scrollHeight||6000;frame.style.height=h+'px';card.querySelector('.framebox').style.height=h*scale+'px';card.querySelector('.viewport').style.height=document.querySelector('main').classList.contains('focus')?'80vh':'770px';})}
function load(){document.querySelectorAll('article').forEach((card,i)=>{const frame=card.querySelector('iframe');frame.onload=()=>{const doc=frame.contentDocument;doc.querySelectorAll('[data-role]').forEach(e=>{if(e.textContent.trim()==='ZenRay')e.dataset.brand=''});const walker=doc.createTreeWalker(doc.body,NodeFilter.SHOW_TEXT);const nodes=[];while(walker.nextNode())if(/\\d/.test(walker.currentNode.textContent)&&!walker.currentNode.parentElement.closest('svg,script,style'))nodes.push(walker.currentNode);for(const n of nodes){const parts=n.textContent.split(/(\\d+(?:[.,]\\d+)?)/g),frag=doc.createDocumentFragment();parts.forEach((part,j)=>{if(j%2){const span=doc.createElement('span');span.className='num';span.textContent=part;frag.append(span)}else frag.append(doc.createTextNode(part))});n.replaceWith(frag)}apply(i);setTimeout(layout,100)};frame.srcdoc=documentFor(mode==='mobile'?390:1440);});}
document.querySelectorAll('article').forEach((card,i)=>{card.querySelectorAll('select').forEach(el=>{el.value=state[i][el.dataset.key];el.onchange=()=>{state[i][el.dataset.key]=el.value;apply(i)}});card.querySelector('input').oninput=e=>{state[i].scale=+e.target.value;apply(i);layout()};card.querySelector('[data-open]').onclick=()=>{document.querySelector('main').classList.add('focus');document.querySelectorAll('article').forEach(c=>c.classList.toggle('selected',c===card));layout()}});
document.querySelector('#compare').onclick=()=>{document.querySelector('main').classList.remove('focus');layout()};for(const type of ['desktop','mobile'])document.querySelector('#'+type).onclick=()=>{mode=type;for(const t of ['desktop','mobile'])document.querySelector('#'+t).setAttribute('aria-pressed',t===mode);load()};document.querySelector('#reset').onclick=()=>location.reload();document.querySelector('#copy').onclick=async()=>{const text=JSON.stringify({body:DEFAULTS.body,numbers:DEFAULTS.number,propositions:state},null,2);try{await navigator.clipboard.writeText(text);document.querySelector('#message').textContent='Valeurs copiées.'}catch{const out=document.querySelector('#output');out.classList.remove('hidden');out.value=text;out.select();document.querySelector('#message').textContent='Valeurs prêtes à copier.'}};new ResizeObserver(layout).observe(document.querySelector('main'));load();
</script></html>`;
fs.writeFileSync(path.join(root,'index.html'),html);console.log('Built',Buffer.byteLength(html),'bytes');
