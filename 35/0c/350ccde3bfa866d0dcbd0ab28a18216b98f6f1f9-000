            <label>Espacement <span class="val-badge" data-val="uiLs">${p.uiLs}em</span></label>
            <input type="range" data-field="uiLs" min="-0.03" max="0.12" step="0.01" value="${p.uiLs}">
          </div>
          <div class="field">
            <label>Graisse</label>
            <select data-field="uiWeight">
              <option value="300" ${p.uiWeight==='300'?'selected':''}>Light 300</option>
              <option value="400" ${p.uiWeight==='400'?'selected':''}>Regular 400</option>
              <option value="500" ${p.uiWeight==='500'?'selected':''}>Medium 500</option>
              <option value="600" ${p.uiWeight==='600'?'selected':''}>SemiBold 600</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Section 6 : Marque ZenRay & Nombres -->
      <div class="control-section">
        <div class="section-head">
          <span>6. Marque "ZenRay" & Nombres (Règle GT Ultra 400)</span>
          <span class="val-badge">${p.brandFont} / ${p.numFont}</span>
        </div>
        <div class="section-grid">
          <div class="field">
            <label>Marque "ZenRay"</label>
            <select data-field="brandFont">${fontSelectOptions(p.brandFont)}</select>
          </div>
          <div class="field">
            <label>Taille Marque <span class="val-badge" data-val="brandScale">${p.brandScale}%</span></label>
            <input type="range" data-field="brandScale" min="80" max="140" value="${p.brandScale}">
          </div>
          <div class="field">
            <label>Espacement Marque <span class="val-badge" data-val="brandLs">${p.brandLs}em</span></label>
            <input type="range" data-field="brandLs" min="-0.05" max="0.12" step="0.01" value="${p.brandLs}">
          </div>
          <div class="field">
            <label>Police Nombres</label>
            <select data-field="numFont">${fontSelectOptions(p.numFont)}</select>
          </div>
          <div class="field">
            <label>Taille Nombres <span class="val-badge" data-val="numScale">${p.numScale}%</span></label>
            <input type="range" data-field="numScale" min="80" max="140" value="${p.numScale}">
          </div>
          <div class="field">
            <label>Espacement Nombres <span class="val-badge" data-val="numLs">${p.numLs}em</span></label>
            <input type="range" data-field="numLs" min="-0.05" max="0.10" step="0.01" value="${p.numLs}">
          </div>
        </div>
      </div>

    </div>

    <!-- Live Preview Viewport -->
    <div class="viewport-container">
      <div class="frame-wrapper">
        <iframe title="Aperçu ${p.id}" sandbox="allow-same-origin allow-scripts"></iframe>
      </div>
    </div>
  </article>
`).join('')}
</main>

<div class="copy-modal" id="modal">
  <div class="modal-box">
    <h3 id="modal-title">Valeurs générées</h3>
    <textarea id="modal-text" readonly></textarea>
    <div class="modal-footer">
      <button class="btn-action primary" id="modal-copy-btn">Copier dans le presse-papier</button>
      <button class="btn-action" id="modal-close-btn">Fermer</button>
    </div>
  </div>
</div>

<script>
const SNAPSHOTS = ${JSON.stringify(snapshots).replace(/</g, '\\u003c')};
const FONT_CSS = ${JSON.stringify(fontCss)};
const INITIAL_STATE = ${JSON.stringify(initialSettings.presets)};
let state = JSON.parse(JSON.stringify(INITIAL_STATE));
let activeViewIndex = 0; // 0: A, 1: B, 2: C, -1: compare
let deviceMode = 'desktop'; // desktop (1440) or mobile (390)

function buildIframeDocument(width) {
  return '<!doctype html><html><head><meta charset="utf-8"><style>' +
    FONT_CSS +
    'html, body { margin: 0; padding: 0; background: #ffffff; }' +
    '* { font-family: var(--font-ui) !important; font-synthesis: none; }' +
    '[data-role="title"], [data-role="title"] * { ' +
    '  font-family: var(--font-title) !important; ' +
    '  font-weight: var(--weight-title) !important; ' +
    '  letter-spacing: var(--ls-title) !important; ' +
    '  line-height: var(--lh-title) !important; ' +
    '}' +
    '[data-role="bio"], [data-role="bio"] * { ' +
    '  font-family: var(--font-bio) !important; ' +
    '  font-weight: var(--weight-bio) !important; ' +
    '  letter-spacing: var(--ls-bio) !important; ' +
    '  line-height: var(--lh-bio) !important; ' +
    '}' +
    '[data-role="body"]:not([data-role="bio"]), [data-role="body"]:not([data-role="bio"]) * { ' +
    '  font-family: var(--font-body) !important; ' +
    '  font-weight: var(--weight-body) !important; ' +
    '  letter-spacing: var(--ls-body) !important; ' +
    '  line-height: var(--lh-body) !important; ' +
    '}' +
    '[data-role="subtitle"], [data-role="subtitle"] * { ' +
    '  font-family: var(--font-sub) !important; ' +
    '  font-weight: var(--weight-sub) !important; ' +
    '  letter-spacing: var(--ls-sub) !important; ' +
    '  line-height: var(--lh-sub) !important; ' +
    '}' +
    '[data-role="ui"], [data-role="ui"] * { ' +
    '  font-family: var(--font-ui) !important; ' +
    '  font-weight: var(--weight-ui) !important; ' +
    '  letter-spacing: var(--ls-ui) !important; ' +
    '  line-height: var(--lh-ui) !important; ' +
    '}' +
    '[data-brand], [data-brand] * { ' +
    '  font-family: var(--font-brand) !important; ' +
    '  letter-spacing: var(--ls-brand) !important; ' +
    '}' +
    '.num { ' +
    '  font-family: var(--font-num) !important; ' +
    '  letter-spacing: var(--ls-num) !important; ' +
    '}' +
    '[data-hover-card]:hover [data-hover-info] { opacity: 1 !important; transform: none !important; }' +
    'body { overflow-x: hidden; }' +
    '</style></head><body>' +
    SNAPSHOTS[width].html +
    '</body></html>';
}

function applyStylesToIframe(i) {
  const card = document.querySelectorAll('article.view-card')[i];
  if (!card) return;
  const frame = card.querySelector('iframe');
  const doc = frame.contentDocument;
  if (!doc || !doc.body) return;

  const s = state[i];
  const r = doc.documentElement;

  // Set CSS Variables
  r.style.setProperty('--font-title', '"' + s.titleFont + '"');
  r.style.setProperty('--weight-title', s.titleWeight);
  r.style.setProperty('--lh-title', s.titleLh);
  r.style.setProperty('--ls-title', s.titleLs + 'em');

  r.style.setProperty('--font-bio', '"' + s.bioFont + '"');
  r.style.setProperty('--weight-bio', s.bioWeight);
  r.style.setProperty('--lh-bio', s.bioLh);
  r.style.setProperty('--ls-bio', s.bioLs + 'em');

  r.style.setProperty('--font-body', '"' + s.bodyFont + '"');
  r.style.setProperty('--weight-body', s.bodyWeight);
  r.style.setProperty('--lh-body', s.bodyLh);
  r.style.setProperty('--ls-body', s.bodyLs + 'em');

  r.style.setProperty('--font-sub', '"' + s.subFont + '"');
  r.style.setProperty('--weight-sub', s.subWeight);
  r.style.setProperty('--lh-sub', s.subLh);
  r.style.setProperty('--ls-sub', s.subLs + 'em');

  r.style.setProperty('--font-ui', '"' + s.uiFont + '"');
  r.style.setProperty('--weight-ui', s.uiWeight);
  r.style.setProperty('--lh-ui', s.uiLh);
  r.style.setProperty('--ls-ui', s.uiLs + 'em');

  r.style.setProperty('--font-brand', '"' + s.brandFont + '"');
  r.style.setProperty('--ls-brand', s.brandLs + 'em');

  r.style.setProperty('--font-num', '"' + s.numFont + '"');
  r.style.setProperty('--ls-num', s.numLs + 'em');

  // Direct scale overrides
  doc.querySelectorAll('[data-role="title"]').forEach(e => {
    e.style.fontSize = (parseFloat(e.dataset.baseSize || 20) * (s.titleScale / 100)) + 'px';
  });

  doc.querySelectorAll('[data-role="bio"]').forEach(e => {
    e.style.fontSize = (parseFloat(e.dataset.baseSize || 16) * (s.bioScale / 100)) + 'px';
    if (s.bioText !== undefined && e.textContent !== s.bioText) {
      e.textContent = s.bioText;
    }
  });

  doc.querySelectorAll('[data-role="body"]:not([data-role="bio"])').forEach(e => {
    e.style.fontSize = (parseFloat(e.dataset.baseSize || 15) * (s.bodyScale / 100)) + 'px';
  });

  doc.querySelectorAll('[data-role="subtitle"]').forEach(e => {
    e.style.fontSize = (parseFloat(e.dataset.baseSize || 13) * (s.subScale / 100)) + 'px';
  });

  doc.querySelectorAll('[data-role="ui"]').forEach(e => {
    e.style.fontSize = (parseFloat(e.dataset.baseSize || 14) * (s.uiScale / 100)) + 'px';
  });

  doc.querySelectorAll('[data-brand]').forEach(e => {
    e.style.fontSize = (parseFloat(e.dataset.baseSize || 24) * (s.brandScale / 100)) + 'px';
  });

  doc.querySelectorAll('.num').forEach(e => {
    e.style.fontSize = (parseFloat(e.dataset.baseSize || 14) * (s.numScale / 100)) + 'px';
  });
}

function updateLayout() {
  const width = deviceMode === 'mobile' ? 390 : 1440;
  document.querySelectorAll('article.view-card').forEach((card, i) => {
    const frame = card.querySelector('iframe');
    const wrapper = card.querySelector('.frame-wrapper');
    const container = card.querySelector('.viewport-container');
    const availableWidth = card.clientWidth;
    const scale = Math.min(1, availableWidth / width);

    frame.style.width = width + 'px';
    frame.style.transform = 'scale(' + scale + ')';

    const h = frame.contentDocument?.body?.scrollHeight || 6500;
    frame.style.height = h + 'px';
    wrapper.style.height = (h * scale) + 'px';
    wrapper.style.width = (width * scale) + 'px';
  });
}

function loadFrames() {
  const width = deviceMode === 'mobile' ? 390 : 1440;
  document.querySelectorAll('article.view-card').forEach((card, i) => {
    const frame = card.querySelector('iframe');
    frame.onload = () => {
      const doc = frame.contentDocument;

      // 1. Tag Brand
      doc.querySelectorAll('[data-role]').forEach(e => {
        if (e.textContent.trim() === 'ZenRay') {
          e.dataset.brand = '';
        }
      });

      // 2. Tag Bio specifically
      doc.querySelectorAll('p').forEach(p => {
        if (p.textContent.includes("Hi, I'm Matthieu")) {
          p.dataset.role = 'bio';
        } else if (p.textContent.includes("Houdini Generator")) {
          p.dataset.role = 'subtitle';
        }
      });

      // 3. Tag Subtitles & Tags
      doc.querySelectorAll('[data-role="ui"]').forEach(e => {
        const text = e.textContent.trim();
        if (/^(Louisiana Bayou|Texturing|3D|Houdini|Unreal Engine|Copernicus|Procedural)$/i.test(text)) {
          e.dataset.role = 'subtitle';
        }
      });

      // 4. Wrap Numbers in span.num
      const walker = doc.createTreeWalker(doc.body, NodeFilter.SHOW_TEXT);
      const textNodes = [];
      while (walker.nextNode()) {
        const node = walker.currentNode;
        if (/\\d/.test(node.textContent) && !node.parentElement.closest('svg, script, style')) {
          textNodes.push(node);
        }
      }
      for (const node of textNodes) {
        const parts = node.textContent.split(/(\\d+(?:[.,]\\d+)?)/g);
        const frag = doc.createDocumentFragment();
        parts.forEach((part, j) => {
          if (j % 2) {
            const span = doc.createElement('span');
            span.className = 'num';
            span.textContent = part;
            frag.append(span);
          } else {
            frag.append(doc.createTextNode(part));
          }
        });
        node.replaceWith(frag);
      }

      // 5. Compute base sizes
      doc.querySelectorAll('[data-role], [data-brand], .num').forEach(el => {
        if (!el.dataset.baseSize) {
          const comp = doc.defaultView.getComputedStyle(el);
          el.dataset.baseSize = parseFloat(comp.fontSize) || 16;
        }
      });

      applyStylesToIframe(i);
      setTimeout(updateLayout, 80);
    };
    frame.srcdoc = buildIframeDocument(width);
  });
}

function bindControls() {
  document.querySelectorAll('article.view-card').forEach((card, i) => {
    // Selects & Inputs
    card.querySelectorAll('[data-field]').forEach(input => {
      const field = input.dataset.field;

      const handleChange = () => {
        let val = input.value;
        if (input.type === 'range') {
          val = input.step && input.step.includes('.') ? parseFloat(val) : parseInt(val, 10);
        }
        state[i][field] = val;

        // Update badge if present
        const badge = card.querySelector('[data-val="' + field + '"]');
        if (badge) {
          if (field.endsWith('Ls')) badge.textContent = val + 'em';
          else if (field.endsWith('Scale')) badge.textContent = val + '%';
          else badge.textContent = val;
        }

        // Summary badges
        const titleSum = card.querySelector('[data-bind="titleSummary"]');
        if (titleSum) titleSum.textContent = state[i].titleFont + ' • ' + state[i].titleScale + '%';

        const bioSum = card.querySelector('[data-bind="bioSummary"]');
        if (bioSum) bioSum.textContent = state[i].bioFont + ' • ' + state[i].bioScale + '%';

        const bodySum = card.querySelector('[data-bind="bodySummary"]');
        if (bodySum) bodySum.textContent = state[i].bodyFont + ' • ' + state[i].bodyScale + '%';

        const subSum = card.querySelector('[data-bind="subSummary"]');
        if (subSum) subSum.textContent = state[i].subFont + ' • ' + state[i].subScale + '%';

        const uiSum = card.querySelector('[data-bind="uiSummary"]');
        if (uiSum) uiSum.textContent = state[i].uiFont + ' • ' + state[i].uiScale + '%';

        applyStylesToIframe(i);
        updateLayout();
      };

      input.addEventListener('input', handleChange);
      input.addEventListener('change', handleChange);
    });

    // Expand button inside card
    const expandBtn = card.querySelector('.btn-expand');
    if (expandBtn) {
      expandBtn.addEventListener('click', () => {
        setFocusMode(i);
      });
    }
  });

  // Navigation Tabs
  document.querySelector('#tab-compare').addEventListener('click', () => setFocusMode(-1));
  document.querySelector('#tab-A').addEventListener('click', () => setFocusMode(0));
  document.querySelector('#tab-B').addEventListener('click', () => setFocusMode(1));
  document.querySelector('#tab-C').addEventListener('click', () => setFocusMode(2));

  // Device Switch
  document.querySelector('#btn-desktop').addEventListener('click', () => {
    deviceMode = 'desktop';
    document.querySelector('#btn-desktop').setAttribute('aria-pressed', 'true');
    document.querySelector('#btn-mobile').setAttribute('aria-pressed', 'false');
    loadFrames();
  });
  document.querySelector('#btn-mobile').addEventListener('click', () => {
    deviceMode = 'mobile';
    document.querySelector('#btn-mobile').setAttribute('aria-pressed', 'true');
    document.querySelector('#btn-desktop').setAttribute('aria-pressed', 'false');
    loadFrames();
  });

  // Action Buttons
  document.querySelector('#btn-copy-css').addEventListener('click', () => {
    const cur = activeViewIndex >= 0 ? state[activeViewIndex] : state[0];
    const cssText = \`:root {
  /* Preset: \${cur.name} */
  --font-title: '\${cur.titleFont}', sans-serif;
  --weight-title: \${cur.titleWeight};
  --lh-title: \${cur.titleLh};
  --ls-title: \${cur.titleLs}em;
  --scale-title: \${cur.titleScale}%;

  --font-bio: '\${cur.bioFont}', serif;
  --weight-bio: \${cur.bioWeight};
  --lh-bio: \${cur.bioLh};
  --ls-bio: \${cur.bioLs}em;
  --scale-bio: \${cur.bioScale}%;

  --font-body: '\${cur.bodyFont}', serif;
  --weight-body: \${cur.bodyWeight};
  --lh-body: \${cur.bodyLh};
  --ls-body: \${cur.bodyLs}em;
  --scale-body: \${cur.bodyScale}%;

  --font-sub: '\${cur.subFont}', sans-serif;
  --weight-sub: \${cur.subWeight};
  --lh-sub: \${cur.subLh};
  --ls-sub: \${cur.subLs}em;
  --scale-sub: \${cur.subScale}%;

  --font-ui: '\${cur.uiFont}', sans-serif;
  --weight-ui: \${cur.uiWeight};
  --lh-ui: \${cur.uiLh};
  --ls-ui: \${cur.uiLs}em;
  --scale-ui: \${cur.uiScale}%;

  --font-brand: '\${cur.brandFont}', sans-serif;
  --ls-brand: \${cur.brandLs}em;
  --scale-brand: \${cur.brandScale}%;

  --font-num: '\${cur.numFont}', sans-serif;
  --ls-num: \${cur.numLs}em;
  --scale-num: \${cur.numScale}%;
}\`;
    openModal('Variables CSS :root (' + cur.name + ')', cssText);
  });

  document.querySelector('#btn-copy-json').addEventListener('click', () => {
    const jsonText = JSON.stringify(state, null, 2);
    openModal('Configuration JSON des propositions', jsonText);
  });

  document.querySelector('#btn-reset').addEventListener('click', () => {
    state = JSON.parse(JSON.stringify(INITIAL_STATE));
    location.reload();
  });

  // Modal controls
  document.querySelector('#modal-close-btn').addEventListener('click', () => {
    document.querySelector('#modal').classList.remove('open');
  });
  document.querySelector('#modal-copy-btn').addEventListener('click', async () => {
    const text = document.querySelector('#modal-text').value;
    await navigator.clipboard.writeText(text);
    document.querySelector('#status-text').textContent = 'Copié dans le presse-papier !';
    setTimeout(() => { document.querySelector('#status-text').textContent = 'Polices prêtes'; }, 2500);
    document.querySelector('#modal').classList.remove('open');
  });
}

function setFocusMode(index) {
  activeViewIndex = index;
  const main = document.querySelector('#main-view');
  const tabs = [
    document.querySelector('#tab-compare'),
    document.querySelector('#tab-A'),
    document.querySelector('#tab-B'),
    document.querySelector('#tab-C')
  ];

  tabs.forEach(t => t.setAttribute('aria-pressed', 'false'));

  if (index === -1) {
    main.className = 'mode-compare';
    tabs[0].setAttribute('aria-pressed', 'true');
    document.querySelectorAll('article.view-card').forEach(c => c.classList.remove('is-active'));
  } else {
    main.className = 'mode-focus';
    tabs[index + 1].setAttribute('aria-pressed', 'true');
    document.querySelectorAll('article.view-card').forEach((c, i) => {
      c.classList.toggle('is-active', i === index);
    });
  }
  updateLayout();
}

function openModal(title, text) {
  document.querySelector('#modal-title').textContent = title;
  document.querySelector('#modal-text').value = text;
  document.querySelector('#modal').classList.add('open');
  document.querySelector('#modal-text').select();
}

window.addEventListener('resize', updateLayout);
bindControls();
loadFrames();
</script>
</body>
</html>`;

fs.writeFileSync(path.join(root, 'index.html'), html);
console.log('Built index.html successfully:', Buffer.byteLength(html), 'bytes');
