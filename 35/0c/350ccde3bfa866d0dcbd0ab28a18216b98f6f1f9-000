const fs=require('fs'),path=require('path');const root=path.dirname(__dirname);
const snapshots=JSON.parse(fs.readFileSync(path.join(root,'Snapshots.json')));
const shared='/Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts';
const fonts={'GT Ultra':shared+'/GT-Ultra-Regular.woff2','Literata':shared+'/Literata-latin.woff2','GT Standard L':shared+'/GT-Standard-L-Regular.woff2','GT America':path.join(root,'GT-America-Regular.woff2')};
